#!/usr/bin/env bb

(require '[babashka.classpath :as classpath]
         '[cheshire.core :as json]
         '[clojure.string :as str])

(defn- manager-root []
  (or (some-> (System/getenv "WORKSTREAM_MANAGER_ROOT") str/trim not-empty)
      (str (java.io.File. (System/getProperty "user.home")
                          "code/projects/workstream-manager"))))

(defn- emit-dependency-error! [root throwable]
  (println
   (json/generate-string
    {:ok false
     :error
     {:code "dependency-unavailable"
      :message (str "Unable to load workstream-manager from " root
                    ": " (or (some-> throwable .getMessage str/trim not-empty)
                             (str throwable)))}}))
  (System/exit 1))

(let [root (manager-root)
      source-dir (java.io.File. root "src")
      cli-file (java.io.File. source-dir "wsm/cli.clj")]
  (try
    (when-not (.isFile cli-file)
      (throw (ex-info (str "Missing workstream-manager entry point: "
                           (.getPath cli-file))
                      {:path (.getPath cli-file)})))
    (classpath/add-classpath (.getPath source-dir))
    (require 'wsm.cli)
    (if-let [main (resolve 'wsm.cli/-main)]
      (main *command-line-args*)
      (throw (ex-info "wsm.cli/-main is unavailable" {})))
    (catch Throwable throwable
      (emit-dependency-error! root throwable))))
