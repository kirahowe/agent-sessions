#!/usr/bin/env bb
;; agents-cli — jj-workspace operations for the Agents macOS app.
;;
;; Contract: every invocation prints EXACTLY ONE JSON object to stdout and
;; exits 0 (ok) or 1 (error), no matter what goes wrong. jj's own
;; stdout/stderr are always captured and never passed through to our stdout.
;;
;;   success: {"ok":true, ...payload}
;;   error:   {"ok":false,"error":{"code":"<code>","message":"<message>"}}
;;
;; workspace-land's success envelope may additionally carry a top-level
;; "warning" string -- present only when the land itself irreversibly
;; succeeded but a non-essential cleanup step afterward failed. Still
;; {"ok":true}; see cmd-workspace-land's comment block for when/why.
;;
;; This is deliberately a single flat script (no internal namespaces) so it
;; stays easy to read as it grows into a bigger engine.

(require '[cheshire.core :as json]
         '[babashka.process :as p]
         '[babashka.fs :as fs]
         '[clojure.string :as str])

;; -----------------------------------------------------------------------
;; Word lists for auto-generated "adjective-noun" workspace names.
;; Kept small and boring on purpose: lowercase, single word, no punctuation,
;; so `adjective + "-" + noun` always satisfies ^[a-z]+-[a-z]+$.

(def adjectives
  ["calm" "bright" "swift" "gentle" "quiet" "brave" "kind" "clever" "eager" "fresh"
   "golden" "happy" "jolly" "keen" "lively" "mellow" "nimble" "plucky" "quick" "radiant"
   "sunny" "tidy" "upbeat" "vivid" "warm" "young" "zesty" "amber" "bold" "crisp"
   "dapper" "earnest" "fair" "gracious" "honest" "jovial" "lucky" "mild" "noble" "patient"])

(def nouns
  ["river" "forest" "ember" "meadow" "harbor" "canyon" "willow" "summit" "brook" "glade"
   "cove" "ridge" "orchard" "prairie" "grove" "lagoon" "valley" "cliff" "delta" "haven"
   "island" "knoll" "lake" "marsh" "nest" "oasis" "peak" "quarry" "reef" "shore"
   "trail" "vale" "wharf" "yard" "zephyr" "bay" "cedar" "dune" "fern" "garden"])

(defn gen-name []
  (str (rand-nth adjectives) "-" (rand-nth nouns)))

;; -----------------------------------------------------------------------
;; Errors. Every failure path throws ex-info carrying {:code :message}; the
;; top-level handler in -main turns that into the error envelope. `code`
;; must always be one of the codes in error-codes below.

(def error-codes #{"not-a-jj-repo" "dest-exists" "name-conflict" "bad-args" "jj-failed"
                    "no-trunk" "land-conflict" "nothing-to-land" "shared-history"})

(defn cli-error [code message]
  (assert (contains? error-codes code) (str "internal: unknown error code " code))
  (throw (ex-info message {:code code :message message})))

;; -----------------------------------------------------------------------
;; Resolving the jj binary. The macOS app launches this script via an
;; absolute-path bb, but when the app is started from Finder/Dock (not a
;; terminal) the process inherits launchd's minimal PATH
;; (/usr/bin:/bin:/usr/sbin:/sbin — no /opt/homebrew/bin), so a bare "jj"
;; resolved via PATH fails with "Cannot run program jj". We resolve jj to an
;; absolute path ourselves instead of trusting PATH: first AGENTS_JJ (an
;; explicit override), then `fs/which` (covers normal terminal use, where
;; PATH is a real login-shell PATH), then a couple of well-known Homebrew
;; install locations as a last resort. Wrapped in a delay so resolution runs
;; at most once, and only when some code path actually tries to run jj --
;; a bad-args error (missing subcommand, unknown subcommand, missing
;; required flag) never touches this and can't fail merely because jj is
;; absent.

;; Kept in sync with ToolPreflight.swift's jj-resolution logic (macOS app) — see that file for why.
(defn resolve-jj []
  (let [env-path (System/getenv "AGENTS_JJ")]
    (or (when (and (not (str/blank? env-path)) (fs/executable? env-path))
          env-path)
        (some-> (fs/which "jj") str)
        (some #(when (fs/executable? %) %) ["/opt/homebrew/bin/jj" "/usr/local/bin/jj"])
        (cli-error "jj-failed"
                   (str "jj not found — set AGENTS_JJ or install jj "
                        "(looked in PATH, /opt/homebrew/bin, /usr/local/bin)")))))

(def jj-path (delay (resolve-jj)))

;; -----------------------------------------------------------------------
;; Shelling out to jj. Global flags (-R, --no-pager) always go before the
;; subcommand — jj is picky about that ordering for some subcommands, so we
;; do it consistently everywhere rather than relying on it not mattering.

(defn run-jj [args]
  (let [result @(p/process (into [@jj-path] args) {:out :string :err :string})]
    {:exit (:exit result) :out (:out result) :err (:err result)}))

(defn stderr-tail
  "Last few lines of stderr, for embedding in jj-failed messages."
  [err]
  (->> (str/split-lines (str/trim (or err "")))
       (take-last 5)
       (str/join "\n")))

(defn jj-failed! [err]
  (cli-error "jj-failed" (str "jj command failed: " (stderr-tail err))))

(defn run-jj-in
  "Like run-jj, but the jj process's CWD is `dir` instead of relying on -R.
   For workspace-land: cwd (not -R) is what selects which workspace's `@` a
   command like rebase/squash/bookmark set/op restore operates on -- this is
   the load-bearing safety property that keeps this command from ever
   touching the default workspace's working copy."
  [dir args]
  (let [result @(p/process (into [@jj-path] args) {:dir dir :out :string :err :string})]
    {:exit (:exit result) :out (:out result) :err (:err result)}))

;; -----------------------------------------------------------------------
;; Path/name conventions shared by every subcommand. The destination for a
;; workspace named `name` under `project` is ALWAYS
;;   <parent-dir-of-project>/workspaces/<name>
;; This is not configurable, and workspace-list reconstructs it the same
;; way (jj's `workspace list` output carries no filesystem path).

(defn workspaces-root [project]
  (str (fs/path (fs/parent project) "workspaces")))

(defn dest-path [project name]
  (str (fs/path (workspaces-root project) name)))

(defn jj-name [name] (str "agents/" name))

(defn assert-jj-repo!
  "Validates that project is a jj repo (git-worktree projects are
   deliberately out of scope for now). Throws not-a-jj-repo otherwise."
  [project]
  (let [{:keys [exit]} (run-jj ["--ignore-working-copy" "--no-pager" "-R" project "root"])]
    (when-not (zero? exit)
      (cli-error "not-a-jj-repo"
                 (str "'" project "' is not a jj repo — jj repos only (for now); "
                      "git-worktree support is deliberately deferred.")))))

(defn parse-colon-prefixed-names
  "Shared parsing idiom for jj registry-listing output (`jj workspace list`,
   `jj bookmark list`): each non-blank line looks like `<name>: ...trailing
   info...`; this returns just the name from each line, in order. Used by
   list-workspace-names, list-bookmark-names, and
   list-bookmark-names-outside below -- all three read the same shape of
   output from different jj registries/contexts."
  [out]
  (->> (str/split-lines out)
       (remove str/blank?)
       (map (fn [line]
              (let [idx (str/index-of line ":")]
                (if idx (subs line 0 idx) line))))))

(defn pick-trunk
  "The first of main/master/trunk present in `bookmark-names` (a coll of
   local bookmark name strings), in that priority order, or nil if none are
   present. Shared priority logic for find-trunk (workspace-land, reading
   via ws-dir once the workspace exists) and cmd-workspace-add's own trunk
   lookup (reading via -R from outside, before any workspace/ws-dir
   exists) -- both need the exact same main/master/trunk preference, just
   sourced from different jj invocations."
  [bookmark-names]
  (let [names (set bookmark-names)]
    (first (filter names ["main" "master" "trunk"]))))

(defn list-workspace-names
  "Raw `jj workspace list` output, as a seq of just the name on each line
   (the part before the first ':'), e.g. \"default\", \"agents/foo\".

   --ignore-working-copy: this is a pure registry read that runs with -R
   from OUTSIDE the repo, which makes jj snapshot the DEFAULT workspace's
   working copy as a side effect -- and, if that working copy happens to be
   stale (its `@` was abandoned by an operation done from some other
   workspace), fail with jj's stale-working-copy error even though this call
   never needed the working copy at all. This read must never trip over (or
   cause) that."
  [project]
  (let [{:keys [exit out err]} (run-jj ["--ignore-working-copy" "--no-pager" "-R" project "workspace" "list"])]
    (when-not (zero? exit) (jj-failed! err))
    (parse-colon-prefixed-names out)))

(defn workspace-name-taken? [project full-name]
  (contains? (set (list-workspace-names project)) full-name))

;; -----------------------------------------------------------------------
;; Argument parsing: subcommand followed by `--flag value` pairs.

(defn parse-flags [args]
  (loop [args args acc {}]
    (if (empty? args)
      acc
      (let [[k v & more] args]
        (when-not (and (string? k) (str/starts-with? k "--") (> (count k) 2))
          (cli-error "bad-args" (str "Expected a --flag, got: " (pr-str k))))
        (when (nil? v)
          (cli-error "bad-args" (str "Missing value for " k)))
        (recur more (assoc acc (keyword (subs k 2)) v))))))

(defn require-flags! [flags & ks]
  (doseq [k ks]
    (when (str/blank? (get flags k))
      (cli-error "bad-args" (str "Missing required --" (name k))))))

;; -----------------------------------------------------------------------
;; workspace-add

(defn check-name-available!
  "Throws name-conflict / dest-exists if `name` is already taken, either in
   jj's workspace registry or on disk (dest dir already there).

   jj-registry is checked first: re-adding the very same name after a
   successful add leaves BOTH the jj workspace and the dest dir present, and
   in that case we want to surface name-conflict (a name collision) rather
   than dest-exists (which is reserved for a directory blocking the way
   that jj never registered, e.g. something pre-existing or left behind)."
  [project name]
  (let [dest (dest-path project name)]
    (when (workspace-name-taken? project (jj-name name))
      (cli-error "name-conflict" (str "jj workspace already exists: " (jj-name name))))
    (when (fs/exists? dest)
      (cli-error "dest-exists" (str "Destination already exists: " dest)))))

(defn pick-name
  "Returns the name to use. An explicit name is validated once, with no
   retry. An auto-generated name is retried up to 5 times on conflict;
   if all 5 attempts collide, the last conflict's error is raised."
  [project explicit-name]
  (if explicit-name
    (do (check-name-available! project explicit-name)
        explicit-name)
    (loop [attempt 1]
      (let [candidate (gen-name)
            outcome (try (check-name-available! project candidate)
                         :available
                         (catch clojure.lang.ExceptionInfo e e))]
        (cond
          (= outcome :available) candidate
          (< attempt 5) (recur (inc attempt))
          :else (throw outcome))))))

(defn list-bookmark-names-outside
  "Local bookmark names for `project`, read via -R from OUTSIDE the repo --
   used by cmd-workspace-add's trunk lookup below, which runs BEFORE any
   workspace directory exists to cd into, so (unlike workspace-land's own
   list-bookmark-names, further down, which runs via cwd once a ws-dir
   exists) this can't use the cwd-based run-jj-in/jj! path.

   --ignore-working-copy, same reasoning as list-workspace-names above: this
   is a pure registry read that runs with -R from outside the repo, which
   makes jj snapshot the DEFAULT workspace's working copy as a side effect,
   and this call must never trip over (or cause) that workspace's
   staleness."
  [project]
  (let [{:keys [exit out err]} (run-jj ["--ignore-working-copy" "--no-pager" "-R" project "bookmark" "list"])]
    (when-not (zero? exit) (jj-failed! err))
    (parse-colon-prefixed-names out)))

(defn cmd-workspace-add [flags]
  (require-flags! flags :project)
  (let [project (str (fs/absolutize (:project flags)))]
    (assert-jj-repo! project)
    (let [name (pick-name project (:name flags))
          dest (dest-path project name)
          root (workspaces-root project)
          ;; Base the new workspace on trunk rather than on the invoking
          ;; workspace's own @-parent, which is what plain `jj workspace
          ;; add` (no -r) does by default. That default is exactly what
          ;; caused the incident this exists to prevent: a workspace added
          ;; while the user had their own unlanded commits in flight forked
          ;; ON TOP of that unlanded work, and a later land (see
          ;; cmd-workspace-land's shared-history guard) had to be taught to
          ;; refuse rather than sweep those commits up as if they belonged
          ;; to the session. Basing on trunk from the moment of creation
          ;; keeps a session's chain disjoint from the user's own in-flight
          ;; stack in the first place. When no trunk bookmark exists yet,
          ;; this falls back to today's exact behavior (no -r at all) --
          ;; cmd-workspace-land's --create-trunk path handles that case.
          trunk (pick-trunk (list-bookmark-names-outside project))]
      ;; jj does NOT create intermediate directories for `workspace add`
      ;; (verified empirically), so we make the workspaces/ parent ourselves.
      (fs/create-dirs root)
      ;; NOTE (verified against jj 0.43.0): `workspace add` itself REFUSES
      ;; --ignore-working-copy ("This command must be able to update the
      ;; working copy") -- unlike the bookmark-list read just above, this
      ;; call never gets that flag.
      (let [add-args (concat ["--no-pager" "-R" project "workspace" "add" "--name" (jj-name name)]
                              (when trunk ["-r" trunk])
                              [dest])
            {:keys [exit err]} (run-jj add-args)]
        (when-not (zero? exit) (jj-failed! err))
        {:ok true
         :workspace {:name name
                     :jj_name (jj-name name)
                     :path dest
                     :project project}}))))

;; -----------------------------------------------------------------------
;; workspace-forget
;;
;; NOTE: empirically, `jj workspace forget <unknown-name>` exits 0 with just
;; a stderr warning ("No such workspace: ...", "Nothing changed.") — it is
;; NOT a jj failure. So this command reports {"ok":true} whenever jj itself
;; exits 0, and jj-failed only on a genuine nonzero exit, same as every
;; other subcommand. This command never touches the directory on disk.
;;
;; --ignore-working-copy, same reasoning as list-workspace-names: this is a
;; repo-level op run with -R from outside the repo, so it snapshots (and can
;; trip over the staleness of) the DEFAULT workspace's working copy as a
;; side effect, even though forgetting a workspace never needed that
;; working copy at all.

(defn cmd-workspace-forget [flags]
  (require-flags! flags :project :name)
  (let [project (str (fs/absolutize (:project flags)))
        name (:name flags)
        {:keys [exit err]} (run-jj ["--ignore-working-copy" "--no-pager" "-R" project "workspace" "forget" (jj-name name)])]
    (when-not (zero? exit) (jj-failed! err))
    {:ok true}))

;; -----------------------------------------------------------------------
;; workspace-list

(defn cmd-workspace-list [flags]
  (require-flags! flags :project)
  (let [project (str (fs/absolutize (:project flags)))
        agents-names (->> (list-workspace-names project)
                           (filter #(str/starts-with? % "agents/"))
                           (map #(subs % (count "agents/"))))]
    {:ok true
     :workspaces (mapv (fn [name]
                          (let [dest (dest-path project name)]
                            {:name name
                             :jj_name (jj-name name)
                             :path dest
                             :dir_exists (fs/exists? dest)}))
                        agents-names)}))

;; -----------------------------------------------------------------------
;; workspace-land
;;
;; "Land" is a MERGE, not a squash: the whole chain lands AS-IS, commit by
;; commit, with its own messages intact -- like merging a branch to main in
;; git via a fast-forward. Advancing the trunk bookmark to the tip of the
;; (now-trunk-based) chain is what actually lands every commit in between;
;; nothing in the chain is rewritten or flattened. This replaced an earlier
;; squash-everything-into-one-commit model, which is what caused the
;; incident this file's staleness hardening and the shared-history guard
;; below both exist to prevent: a squash-based land silently flattened
;; commits that predated the session and were never the session's to
;; rewrite, because `jj workspace add` (no -r) had based the session on the
;; user's own in-flight stack rather than trunk. cmd-workspace-add now bases
;; new workspaces on trunk for exactly this reason (see its own comment),
;; and the shared-history guard below is a second, independent line of
;; defense for any chain that ends up sharing history with another
;; workspace anyway.
;;
;; --message's role is narrower than the flag name suggests, and than it
;; was under the old squash model: it is NEVER used to overwrite the
;; session's own commit messages. It describes ONLY trailing UNCOMMITTED
;; work sitting in `@` at land time, and only when that `@` has no
;; description of its own yet (an agent that already ran `jj describe` on
;; its own `@` keeps its own message; --message is ignored for it in that
;; case). It remains a REQUIRED flag regardless, because the app always
;; sends one and there's no way to know in advance whether `@` will need it
;; -- see the landing steps below for exactly when it is and isn't used.
;;
;; ASSUMPTION: the session's own chain is linear. A multi-parent `@` (the
;; workspace's own history containing a merge commit) is out of scope and
;; not handled specially -- the tip/rebase logic below assumes a single
;; line of descent from trunk to `@`.
;;
;; jj auto-abandons a trivial (empty, undescribed) working-copy commit when
;; you move off it, so after the final forget below, an empty undescribed
;; leftover `@` (the common case: no trailing edit at land time) simply
;; vanishes on its own. An empty but DESCRIBED `@` (rare: the agent
;; described it but never gave it real content) doesn't get that automatic
;; cleanup and may linger as a harmless dangling commit -- deliberately not
;; worth adding cleanup machinery for.
;;
;; On any conflict, shared-history refusal, or unexpected jj failure UP
;; THROUGH the bookmark move, every bit of prior state (trunk position,
;; workspace registration, the workspace's commit chain, its directory) is
;; either never touched at all -- the nothing-to-land check and the
;; shared-history guard are both read-only and run before any mutation
;; begins -- or restored via `jj op restore` for the mutating steps (3.5
;; onward, inside the try/catch). Nothing partially mutated is ever left
;; behind. Once the bookmark move has gone through, though, the land is
;; irreversibly done; see step 8's own comment for what that means for its
;; failure handling.
;;
;; CWD (not -R) is what selects which workspace's `@` a jj command targets,
;; so every jj call below that needs to act on the WORKSPACE's own `@` runs
;; via run-jj-in on the workspace's dest dir. The ONE exception is the final
;; `workspace forget`, which runs from OUTSIDE the workspace dir (ordinary
;; run-jj + -R project, exactly like cmd-workspace-forget) since forgetting
;; while it's the cwd is asking for trouble and it's a repo-level op anyway.
;; This cwd discipline is the load-bearing property that keeps the DEFAULT
;; workspace's own working copy from ever being touched by MOST of this
;; command -- the final forget is a deliberate, flagged exception (see step
;; 8), same as list-workspace-names and cmd-workspace-forget.
;;
;; Staleness hardening (the reason for step 0.5 and step 8's flag/failure
;; handling below): jj commands run with -R from outside a repo snapshot the
;; DEFAULT workspace's working copy as a side effect, and fail outright if
;; that working copy is stale. Separately, THIS workspace's own `@` can be
;; made stale by jj activity elsewhere (most plausibly the user's own jj
;; commands in the default workspace, but any workspace could do it). Left
;; unhandled, either kind of staleness can turn a perfectly landable
;; workspace into a reported failure -- including, in the worst case, AFTER
;; the bookmark move already succeeded, which is exactly the incident this
;; hardening fixes: a completed land reported back as failed.

(defn jj!
  "run-jj-in, but throws jj-failed! on nonzero exit. Used throughout
   workspace-land wherever a jj call must succeed or the whole command
   aborts (and, on the mutating steps, triggers a rollback -- see below)."
  [dir args]
  (let [{:keys [exit err] :as result} (run-jj-in dir args)]
    (when-not (zero? exit) (jj-failed! err))
    result))

(defn jj-line!
  "jj!, returning trimmed single-line stdout -- for the -T template calls
   that capture a single commit id / operation id."
  [dir args]
  (str/trim (:out (jj! dir args))))

(def commit-id-template "commit_id ++ \"\\n\"")
(def op-id-template "id.short() ++ \"\\n\"")

(defn list-bookmark-names
  "Local bookmark names (`jj bookmark list`, no -a -- this deliberately
   excludes remote-tracking pseudo-entries like @git), via cwd-based jj! on
   ws-dir (the workspace already exists by the time this is called, unlike
   cmd-workspace-add's list-bookmark-names-outside above)."
  [dir]
  (let [{:keys [out]} (jj! dir ["--no-pager" "bookmark" "list"])]
    (parse-colon-prefixed-names out)))

(defn find-trunk
  "The first of main/master/trunk that exists as a LOCAL bookmark in
   ws-dir, in that priority order, or nil if none do."
  [ws-dir]
  (pick-trunk (list-bookmark-names ws-dir)))

(defn cmd-workspace-land [flags]
  (require-flags! flags :project :name :message)
  (let [project (str (fs/absolutize (:project flags)))
        name (:name flags)
        message (:message flags)
        create-trunk (:create-trunk flags)
        full-name (jj-name name)]
    (assert-jj-repo! project)
    ;; Step 0: fail fast if the workspace isn't registered, rather than
    ;; letting some later jj command fail organically inside ws-dir.
    (when-not (contains? (set (list-workspace-names project)) full-name)
      (cli-error "jj-failed" (str "workspace not registered: " full-name)))
    (let [ws-dir (dest-path project name)]
      ;; Step 0.5: recover the SESSION workspace's own working copy if it
      ;; was made stale by jj activity elsewhere. Every jj call below runs
      ;; with ws-dir as cwd, so a stale ws-dir would otherwise make
      ;; find-trunk (and everything after it) fail organically with jj's
      ;; stale-working-copy error, turning a perfectly landable workspace
      ;; into a jj-failed. Empirically verified as a safe, exit-0 no-op
      ;; ("Attempted recovery, but the working copy is not stale") when
      ;; ws-dir is already fresh, so this runs unconditionally rather than
      ;; trying to detect staleness first.
      (jj! ws-dir ["--no-pager" "workspace" "update-stale"])
      (let [trunk (find-trunk ws-dir)]
        (when (and (not trunk) (str/blank? create-trunk))
          (cli-error "no-trunk"
                     (str "No trunk bookmark found (looked for main, master, trunk). "
                          "Pass --create-trunk <name> to have the app create one.")))
        (let [bookmark-name (or trunk create-trunk)
              ;; Step 1: merge-base of trunk (or, in the --create-trunk case,
              ;; the default workspace) vs @. Needed for the nothing-to-land
              ;; check, and -- only in the --create-trunk branch, which has no
              ;; named trunk to rebase onto -- as the base of the
              ;; landing-range/conflict-check revsets too.
              base (jj-line! ws-dir
                              ["--no-pager" "log" "--no-graph" "-r"
                               (if trunk
                                 (str "heads(::" trunk " & ::@)")
                                 "heads(::@ & ::default@)")
                               "-T" commit-id-template])
              diff-out (:out (jj! ws-dir ["--no-pager" "diff" "--from" base "--to" "@"]))]
          ;; Step 2: nothing-to-land check, still entirely read-only.
          (when (str/blank? diff-out)
            (cli-error "nothing-to-land"
                       (str "Nothing to land: " name " has no content changes since it diverged.")))
          ;; Step 2.5 (NEW): the shared-history guard -- still entirely
          ;; read-only, and runs BEFORE the opid capture / mutation phase
          ;; below, so a refusal here leaves EVERYTHING untouched. This is
          ;; the incident's own reenactment check: the landing range
          ;; (trunk..@, or base..@ when there's no trunk yet) is intersected
          ;; against the ancestors of every OTHER workspace's own
          ;; working-copy commit -- default's, other agents/* sessions', and
          ;; any workspace the user added by hand, straight from jj's own
          ;; registry. A non-empty intersection means landing
          ;; would sweep up commits that are ALSO part of another
          ;; workspace's line -- almost always because this workspace was
          ;; itself created on top of unlanded work (the exact scenario
          ;; cmd-workspace-add's trunk-basing now prevents at creation time;
          ;; this is the second, independent line of defense for any chain
          ;; that ends up sharing history anyway, e.g. one added the old
          ;; hazardous way).
          ;;
          ;; `"agents/foo"@` (a quoted workspace name followed by `@`) is
          ;; valid jj revset syntax for that workspace's own working-copy
          ;; commit -- verified empirically against this machine's jj
          ;; 0.43.0 -- so each other workspace's `@` is referenced directly
          ;; in the combined revset string below, with no need to resolve
          ;; it to a commit id first.
          (let [landing-range (if trunk (str trunk "..@") (str base "..@"))
                ;; EVERY other workspace's line counts, not just default's
                ;; and other agents/* sessions': a workspace the user added
                ;; by hand shares history just as easily, and jj's registry
                ;; already tells us about all of them.
                other-ws-ats (->> (list-workspace-names project)
                                  (remove #(= % full-name))
                                  (map #(str "::\"" % "\"@")))
                shared-revset (str "(" landing-range ") & (" (str/join " | " other-ws-ats) ")")
                shared-out (:out (jj! ws-dir ["--no-pager" "log" "--no-graph" "-r" shared-revset
                                              "-T" "commit_id.short() ++ \" \" ++ description.first_line() ++ \"\\n\""]))]
            (when-not (str/blank? shared-out)
              (cli-error "shared-history"
                         (str "Landing " name " would sweep up commits that are also part of "
                              "another workspace's line (usually a workspace created on top of "
                              "unlanded work): "
                              (str/join "; " (str/split-lines (str/trim shared-out)))
                              ". Rebase " name "'s chain onto " bookmark-name
                              ", or land the shared work first."))))
          ;; Step 3: capture the operation id -- the rollback point for
          ;; everything from here on.
          (let [opid (jj-line! ws-dir ["--no-pager" "op" "log" "--no-graph" "-n" "1" "-T" op-id-template])
                commit-id
                (try
                  ;; Step 3.5: rebase the workspace's chain onto trunk. Only
                  ;; when an existing trunk was found; always safe to run even
                  ;; if @ is already directly on top of it (jj no-ops).
                  (when trunk
                    (jj! ws-dir ["--no-pager" "rebase" "-s" (str "roots(" trunk "..@)") "-d" trunk]))
                  ;; Step 4: conflict check.
                  (let [conflict-revset (if trunk
                                          (str "(" trunk "..@) & conflicts()")
                                          (str "(" base "..@) & conflicts()"))
                        conflicts (:out (jj! ws-dir ["--no-pager" "log" "--no-graph" "-r" conflict-revset
                                                      "-T" commit-id-template]))]
                    (when-not (str/blank? conflicts)
                      (cli-error "land-conflict"
                                 (str "Landing conflicts with " bookmark-name
                                      "; rolled back — trunk and workspace are unchanged. "
                                      "Resolve the conflict and try again."))))
                  ;; Step 5 (NEW landing model, replacing the old squash):
                  ;; find the tip of the chain to advance the bookmark to.
                  ;; If @ is non-empty (trailing uncommitted work), it
                  ;; becomes the tip and joins the landed chain: describe it
                  ;; with --message ONLY if it has no description of its own
                  ;; yet (an agent that already described its own @ keeps
                  ;; that message, and --message is ignored for it). If @ is
                  ;; empty, there is no trailing work to land -- @- (the
                  ;; last real chain commit) is the tip instead, and the
                  ;; empty @ itself is left alone rather than landed (see
                  ;; this section's header comment for what becomes of it
                  ;; after the final forget).
                  (let [at-empty? (= "true" (jj-line! ws-dir ["--no-pager" "log" "--no-graph" "-r" "@"
                                                              "-T" "if(empty, \"true\", \"false\")"]))
                        tip-revset (if at-empty? "@-" "@")]
                    (when-not at-empty?
                      (let [at-desc (jj-line! ws-dir ["--no-pager" "log" "--no-graph" "-r" "@" "-T" "description"])]
                        (when (str/blank? at-desc)
                          (jj! ws-dir ["--no-pager" "describe" "-r" "@" "-m" message]))))
                    ;; Step 6: advance/create the trunk bookmark at the tip's
                    ;; commit id, captured from the SAME tip-revset used for
                    ;; the bookmark move itself, AFTER the describe above (if
                    ;; any ran) -- describing rewrites the commit id, so this
                    ;; must come after it, not before. This bookmark move is
                    ;; what actually lands the whole chain: everything
                    ;; between trunk and the tip goes along for the ride,
                    ;; as-is, the same as a fast-forward merge in git.
                    (let [cid (jj-line! ws-dir ["--no-pager" "log" "--no-graph" "-r" tip-revset "-T" commit-id-template])]
                      (if trunk
                        (jj! ws-dir ["--no-pager" "bookmark" "set" trunk "-r" tip-revset])
                        (jj! ws-dir ["--no-pager" "bookmark" "create" create-trunk "-r" tip-revset]))
                      cid))
                  (catch Throwable t
                    ;; Best-effort rollback: restore, then rethrow the
                    ;; ORIGINAL exception unchanged so -main reports the
                    ;; correct error code/message regardless of whether the
                    ;; restore itself succeeds.
                    (try (run-jj-in ws-dir ["--no-pager" "op" "restore" opid])
                         (catch Throwable _ nil))
                    (throw t)))
                landed {:commit_id commit-id
                        :bookmark bookmark-name
                        :workspace name}]
            ;; Step 8: forget the workspace. Deliberately OUTSIDE ws-dir (-R
            ;; project via ordinary run-jj), same as cmd-workspace-forget --
            ;; this is a repo-level op and running it with ws-dir as cwd risks
            ;; forgetting the very workspace jj thinks it's standing in.
            ;; --ignore-working-copy for the same reason as
            ;; list-workspace-names/cmd-workspace-forget: this call runs with
            ;; -R from outside the repo, which snapshots the DEFAULT
            ;; workspace's working copy as a side effect -- if that happens
            ;; to be stale, an unflagged forget would fail here even though
            ;; forgetting never needed the working copy at all.
            ;;
            ;; By this point steps 5-6 above have already irreversibly
            ;; succeeded -- the chain is rebased and the bookmark has moved,
            ;; so the land itself HAS HAPPENED. A forget failure here (jj
            ;; hiccup, or something --ignore-working-copy doesn't cover)
            ;; therefore must NOT be reported as a jj-failed error: the
            ;; caller would see {"ok":false} for a land that actually
            ;; succeeded, which is precisely the incident this hardening
            ;; exists to fix (a completed land reported back as failed).
            ;; Instead this returns the normal success envelope plus a
            ;; top-level :warning describing the manual cleanup step, and
            ;; leaves the workspace registered in jj for the user (or a
            ;; retried workspace-forget) to deal with later.
            (let [{:keys [exit err]} (run-jj ["--ignore-working-copy" "--no-pager" "-R" project "workspace" "forget" full-name])]
              (if (zero? exit)
                {:ok true :landed landed}
                {:ok true
                 :landed landed
                 :warning (str "Changes were kept, but the workspace couldn't be deregistered — "
                               "run `jj workspace forget " full-name "` in " project
                               " to finish cleaning up (jj said: " (stderr-tail err) ").")}))))))))

;; -----------------------------------------------------------------------
;; Dispatch + top-level error handling.

(defn dispatch [args]
  (let [[subcmd & rest-args] args]
    (when (str/blank? subcmd)
      (cli-error "bad-args" "Missing subcommand. Expected one of: workspace-add, workspace-forget, workspace-list, workspace-land."))
    (let [flags (parse-flags rest-args)]
      (case subcmd
        "workspace-add"    (cmd-workspace-add flags)
        "workspace-forget" (cmd-workspace-forget flags)
        "workspace-list"   (cmd-workspace-list flags)
        "workspace-land"   (cmd-workspace-land flags)
        (cli-error "bad-args" (str "Unknown subcommand: " subcmd))))))

(defn emit! [m]
  (println (json/generate-string m))
  (System/exit (if (:ok m) 0 1)))

(defn -main [args]
  (try
    (emit! (dispatch args))
    (catch clojure.lang.ExceptionInfo e
      (let [{:keys [code message]} (ex-data e)]
        (emit! {:ok false :error {:code code :message message}})))
    (catch Throwable t
      (emit! {:ok false :error {:code "bad-args" :message (str "Unexpected error: " (.getMessage t))}}))))

(-main *command-line-args*)
