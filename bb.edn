{:tasks
 {gen {:doc "Generate the Xcode project via XcodeGen"
       :task (shell {:dir "macapp"} "xcodegen generate")}

  build {:doc "Generate the project, then build Debug"
         :depends [gen]
         :task (shell "xcodebuild" "-project" "macapp/Agents.xcodeproj"
                       "-scheme" "Agents" "-configuration" "Debug"
                       "-derivedDataPath" "macapp/.build" "build")}

  ;; The Debug bundle is "Agents Dev.app", not "Agents.app" — the wrapper
  ;; name is config-dependent so macOS can tell a dev build from a release
  ;; one (see WRAPPER_NAME in macapp/project.yml).
  run {:doc "Build, then launch the built app"
       :depends [build]
       :task (shell "open" "macapp/.build/Build/Products/Debug/Agents Dev.app")}

  ;; Tests build into their own derived-data path, never macapp/.build:
  ;; `bb run` launches the app from macapp/.build/Build/Products/Debug, and
  ;; a test build sharing that path replaces the .app bundle underneath the
  ;; running process — which corrupts it in ways that only surface as
  ;; unrelated-looking glitches minutes later. The cost is a second full
  ;; build the first time; the alternative was observed breaking a live app
  ;; mid-use (2026-08-31).
  test {:doc "Generate the project, then run the AgentsTests unit test suite"
        :depends [gen]
        :task (shell "xcodebuild" "-project" "macapp/Agents.xcodeproj"
                      "-scheme" "Agents" "-destination" "platform=macOS"
                      "-derivedDataPath" "macapp/.build-tests" "test")}

  clean {:doc "Remove the generated Xcode project and build artifacts"
         :task (shell "rm" "-rf" "macapp/Agents.xcodeproj" "macapp/.build" "macapp/.build-tests")}

  cli-test {:doc "Run the agents-cli behavioral test suite"
            :task (shell "bb" "cli/test_agents_cli.clj")}

  icon {:doc "Render the app icon PNGs into the asset catalog"
        :task (shell "swift" "design/icon/RenderAppIcon.swift")}

  ;; Releases are built and published by the Nightly workflow on GitHub,
  ;; never locally: the runner pins the SDK the app compiles against, and
  ;; the Sparkle appcast is signed with a key that lives only in the
  ;; repository secrets. This task dispatches that workflow for main and
  ;; watches the run — the sequence that used to be done by hand.
  publish {:doc "Publish GitHub main as the rolling nightly release the in-app updater serves"
           :task (shell "bb" "scripts/publish.clj")}}}
